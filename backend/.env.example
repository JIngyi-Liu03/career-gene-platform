# 本地开发用。Docker 部署时由 docker-compose 注入，无需此文件。
# 本地需先启动一个 PostgreSQL，并替换下方连接串。
DATABASE_URL="postgresql://career:career_pass@localhost:5432/career_gene?schema=public"

# 服务监听端口（Docker 容器内固定 3000，由 nginx 反代）
PORT=3000

# JWT 双 Token 密钥（本地未设置时回退到 jwt.constants.ts 的 dev 默认值）
ACCESS_JWT_SECRET=dev-access-secret-change-me
REFRESH_JWT_SECRET=dev-refresh-secret-change-me

# 管理后台本地开发账号密码（生产请使用强密码并通过 .env 注入）
ADMIN_USERNAME=JLY
ADMIN_PASSWORD=ljyLJY

# —— 腾讯云短信（可选；未配置密钥时走 dev 回显，验证码直接返回给前端）——
# SMS_PROVIDER=tencent
# TENCENT_SECRET_ID=你的SecretId
# TENCENT_SECRET_KEY=你的SecretKey
# SMS_SDK_APP_ID=1401170787
# SMS_SIGN_NAME=上海盟珂教育科技
# SMS_TEMPLATE_ID=2704021
# SMS_REGION=ap-guangzhou
# SMS_CODE_TTL=300000
# SMS_SEND_INTERVAL=60000
