# 生产部署密钥模板 —— 复制为 .env 并填入强随机值后再部署。
# 生成方式（任选）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32

# PostgreSQL 密码（db 与 api 的 DATABASE_URL 共用，必须一致）
DB_PASSWORD=change-me-strong-db-password

# 完整数据库连接串（注意密码中避免使用 / + @ 等特殊字符，推荐只含 0-9a-fA-F）
DATABASE_URL=postgresql://career:change-me-strong-db-password@db:5432/career_gene?schema=public

# JWT 双 Token 签名密钥（建议各 ≥32 字节随机；不可使用 dev 占位值）
ACCESS_JWT_SECRET=change-me-access-secret-min-32-bytes
REFRESH_JWT_SECRET=change-me-refresh-secret-min-32-bytes

# 管理后台（8081）登录账号密码。生产环境必填，缺失将拒绝启动。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
# 可选：以 bcrypt 哈希代替明文密码（优先级高于 ADMIN_PASSWORD）。
# ADMIN_PASSWORD_HASH=$(node -e "console.log(require('bcryptjs').hashSync('你的密码',10))")
